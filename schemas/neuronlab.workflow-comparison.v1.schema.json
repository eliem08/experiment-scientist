{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eliem08/experiment-scientist/blob/main/schemas/neuronlab.workflow-comparison.v1.schema.json",
  "title": "NeuronLab Workflow Comparison",
  "description": "Baseline-versus-candidate metric comparison with explicit regression thresholds.",
  "type": "object",
  "required": [
    "schema_version",
    "comparison_id",
    "created_at_utc",
    "baseline",
    "candidate",
    "thresholds",
    "gate",
    "comparisons",
    "warnings",
    "interpretation_limits"
  ],
  "properties": {
    "schema_version": {
      "const": "neuronlab.workflow-comparison.v1"
    },
    "comparison_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "baseline": {
      "$ref": "#/$defs/run"
    },
    "candidate": {
      "$ref": "#/$defs/run"
    },
    "thresholds": {
      "type": "object",
      "required": ["max_pass_rate_drop", "max_forbidden_hit_increase"],
      "properties": {
        "max_pass_rate_drop": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_forbidden_hit_increase": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["passed", "blockers"],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "metric", "label", "direction", "baseline", "candidate", "delta", "regression"],
        "properties": {
          "stage": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "direction": {
            "enum": ["higher", "lower", "neutral"]
          },
          "baseline": {},
          "candidate": {},
          "delta": {
            "type": ["number", "null"]
          },
          "regression": {
            "type": ["boolean", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interpretation_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["workflow_id", "model_id"],
      "properties": {
        "workflow_id": {
          "type": ["string", "null"]
        },
        "model_id": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
